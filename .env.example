# Required: signs sessions (generate with: openssl rand -base64 32)
LANETRACE_SECRET=

# Postgres used by docker-compose (a pre-0.3 AgentTrace volume: set all three to agenttrace)
POSTGRES_DB=lanetrace
POSTGRES_USER=lanetrace
POSTGRES_PASSWORD=lanetrace

# Other Python server variables (optional; set in the environment):
#   DATABASE_URL              SQLAlchemy URL, e.g. postgresql+psycopg://user:pass@host:5432/db
#                             (compose sets this for you; default is a local SQLite file)
#   LANETRACE_AUTH            none | password (default for `lanetrace ui --auth`; unset: none on loopback,
#                             password otherwise — the image binds 0.0.0.0, so password)
#   LANETRACE_ALLOWED_HOSTS   comma-separated public hostnames accepted in the Host header
#
# Each LANETRACE_* variable also accepts its pre-0.3 AGENTTRACE_* name (deprecated).
