# AgentTrace — .dockerignore
# Keep build context lean so Docker cache + build are fast.

# deps & build artifacts
node_modules
.next
out
dist
build
**/node_modules
**/dist
**/build
**/*.egg-info

# python
**/__pycache__
**/*.pyc
.venv
python-server/.venv
.pytest_cache
.ruff_cache
.mypy_cache

# bundled UI is rebuilt in the `ui` stage
python-server/agenttrace/server/static

# logs & local state
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.db
*.db-journal

# editor / OS
.git
.gitignore
.github
.vscode
.idea
.DS_Store
*.swp

# docs & examples (not needed in the image)
docs
examples
python-server/examples
.superpowers

# docker
Dockerfile
.dockerignore
docker-compose.yml
docker-compose.*.yml

# misc
.env*.local
.env
worklog.md
agent-ctx
/*.png
